{
  "name": "@tiaanduplessis/react-progressbar",
  "version": "1.0.0",
  "description": "Little React wrapper around progressbar.js",
  "author": "tiaanduplessis",
  "license": "MIT",
  "repository": "tiaanduplessis/react-progressbar",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "jsnext:main": "dist/index.es.js",
  "engines": {
    "node": ">=8",
    "npm": ">=5"
  },
  "scripts": {
    "lint": "eslint src test rollup.config.mjs eslint.config.mjs",
    "test": "node --test --test-timeout=10000 test/characterization.test.cjs test/integration.test.cjs",
    "test:watch": "node --test --watch test/*.test.cjs",
    "build": "rollup -c rollup.config.mjs",
    "start": "rollup -c rollup.config.mjs -w",
    "check": "npm run lint && npm run build && npm test && npm run test:dist",
    "prepare": "npm run build",
    "test:dist": "node --test --test-timeout=10000 test/distribution.test.cjs"
  },
  "peerDependencies": {
    "react": "^16.8.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-class-properties": "7.29.7",
    "@babel/plugin-transform-object-rest-spread": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "rollup": "4.63.5",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "jsdom": "30.1.1",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "acorn": "8.18.0"
  },
  "dependencies": {
    "progressbar.js": "^1.1.0"
  },
  "packageManager": "yarn@1.22.22",
  "files": [
    "dist",
    "src/index.js"
  ]
}
